# MQTT credentials for the Alde bridge scripts.
# Install on the Pi (never commit the real file):
#   sudo mkdir -p /etc/alde
#   sudo cp /home/alde/mqtt.env.example /etc/alde/mqtt.env
#   sudo nano /etc/alde/mqtt.env        # set the real password
#   sudo chmod 600 /etc/alde/mqtt.env
MQTT_USER=round
MQTT_PASS=changeme
